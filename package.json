{
  "name": "folio",
  "version": "0.2.0",
  "description": "Folio — Zotero 라이브러리 위에 개인 논문 아카이브 + 메모를 얹는 개인용 도구",
  "type": "module",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix web run build",
    "build:web": "npm --prefix web install && npm --prefix web run build",
    "migrate:supabase": "node server/scripts/migrate-to-supabase.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "adm-zip": "^0.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "marked": "^18.0.11",
    "turndown": "^7.2.4"
  }
}
