PORT=3002

# Zotero OAuth 앱 등록 후 발급받는 값 (https://www.zotero.org/oauth/apps)
ZOTERO_CLIENT_KEY=
ZOTERO_CLIENT_SECRET=

# 서버가 외부에서 접속 가능한 주소 (OAuth 콜백 URL 구성에 사용).
# 로컬에서만 쓸 땐 비워두면 http://localhost:$PORT 를 기본값으로 씀.
# https:// 로 시작하면 세션 쿠키가 secure로 발급된다.
APP_BASE_URL=

# Supabase 프로젝트 (Project Settings → API).
# service_role 키는 RLS를 우회하는 관리자 키다 — 절대 브라우저로 내려보내지 말 것.
# 브라우저는 Supabase에 직접 붙지 않고 항상 이 서버를 거치므로 anon 키는 필요 없다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 로그인 세션 쿠키 서명 키 (아무 긴 랜덤 문자열).
# 비워두면 서버가 부팅할 때마다 임시 키를 만들어서, 재시작하면 로그인이 풀린다.
SESSION_SECRET=
